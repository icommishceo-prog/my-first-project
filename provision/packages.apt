# Debian/Ubuntu packages installed by provision.sh and baked into the ISO.
# One package per line. Lines starting with '#' and blank lines are ignored.
#
# NOTE: Only packages actually present in Debian 12 (bookworm) main/contrib are
# listed here. OSINT tools that are NOT in Debian (theHarvester, recon-ng) are
# installed via pipx instead (see packages.pipx); amass is a Go tool (see
# packages.go). The provisioner skips any package unavailable in your release.

# --- Desktop / theming base ---
xfce4
xfce4-goodies
xfce4-whiskermenu-plugin
lightdm
firefox-esr
fonts-liberation
papirus-icon-theme
gtk2-engines-murrine
arc-theme
imagemagick

# --- Core utilities ---
git
curl
wget
ca-certificates
unzip
jq
xmlstarlet
python3
python3-pip
python3-venv
pipx

# --- OSINT: genuinely in Debian repos ---
dnsrecon
whois
bind9-dnsutils
libimage-exiftool-perl
