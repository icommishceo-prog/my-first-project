ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Comma-separated ticker watchlist (no spaces)
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,META,NVDA,BRK-B,JPM,UNH,V

# Slack Incoming Webhook URL (optional — leave blank to disable alerts)
# Create one at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=
